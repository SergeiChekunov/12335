--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:ForwardingFailedParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:ATI-NotAllowedParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:ATSI-NotAllowedParam ::=  SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:ATM-NotAllowedParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
