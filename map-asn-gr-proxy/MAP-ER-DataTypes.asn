--unused:
--unused:UnauthorizedLCSClient-Param ::= SEQUENCE {
--unused:	unauthorizedLCSClient-Diagnostic [0] UnauthorizedLCSClient-Diagnostic OPTIONAL,
--unused:	extensionContainer  [1] ExtensionContainer    OPTIONAL,
--unused:	... }
--unused:
--unused:UnauthorizedLCSClient-Diagnostic ::= ENUMERATED {
--unused:	noAdditionalInformation (0),
--unused:	clientNotInMSPrivacyExceptionList (1),
--unused:	callToClientNotSetup (2),
--unused:	privacyOverrideNotApplicable (3),
--unused:	disallowedByLocalRegulatoryRequirements (4),
--unused:	...,
--unused:	unauthorizedPrivacyClass (5),
--unused:	unauthorizedCallSessionUnrelatedExternalClient (6),
--unused:	unauthorizedCallSessionRelatedExternalClient (7) }
--unused:- - exception handling:
--unused:- - any unrecognized value shall be ignored
--unused:
--unused:PositionMethodFailure-Param ::= SEQUENCE {
--unused:	positionMethodFailure-Diagnostic [0] PositionMethodFailure-Diagnostic OPTIONAL,
--unused:	extensionContainer  [1] ExtensionContainer    OPTIONAL,
--unused:	... }
--unused:
--unused:PositionMethodFailure-Diagnostic ::= ENUMERATED {
--unused:	congestion  (0),
--unused:	insufficientResources  (1),
--unused:	insufficientMeasurementData  (2),
--unused:	inconsistentMeasurementData  (3),
--unused:	locationProcedureNotCompleted  (4),
--unused:	locationProcedureNotSupportedByTargetMS  (5),
--unused:	qoSNotAttainable  (6),
--unused:	positionMethodNotAvailableInNetwork (7),
--unused:	positionMethodNotAvailableInLocationArea (8),
--unused:	... }
--unused:- - exception handling:
--unused:- -  any unrecognized value shall be ignored
--unused:
