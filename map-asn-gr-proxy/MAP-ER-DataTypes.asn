-- ETSI TS 129 002 V10.4.0 (2011-10)
-- 17.7.7  Error data types

MAP-ER-DataTypes {
	itu-t identified-organization (4) etsi (0) mobileDomain (0)
	gsm-Network (1) modules (3) map-ER-DataTypes (17) version13 (13)}

DEFINITIONS

IMPLICIT TAGS

::=

BEGIN

EXPORTS
	--unused:RoamingNotAllowedParam,
	--unused:CallBarredParam,
