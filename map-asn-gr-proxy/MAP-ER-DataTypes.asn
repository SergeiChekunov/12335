	--unused:InformationNotAvailableParam,
	--unused:TargetCellOutsideGCA-Param,
	--unused:OngoingGroupCallParam

	;

--unused:IMPORTS
--unused:	SS-Status
--unused:FROM MAP-SS-DataTypes {
--unused:	itu-t identified-organization (4) etsi (0) mobileDomain (0)
--unused:	gsm-Network (1) modules (3) map-SS-DataTypes (14) version13 (13)}
--unused:
--unused:	SignalInfo,
--unused:	BasicServiceCode,
--unused:	NetworkResource,
--unused:	AdditionalNetworkResource
--unused:FROM MAP-CommonDataTypes {
--unused:	itu-t identified-organization (4) etsi (0) mobileDomain (0)
--unused:	gsm-Network (1) modules (3) map-CommonDataTypes (18) version13 (13)}
--unused:
--unused:	SS-Code
--unused:FROM MAP-SS-Code {
--unused:	itu-t identified-organization (4) etsi (0) mobileDomain (0)
--unused:	gsm-Network (1) modules (3) map-SS-Code (15) version13 (13)}
--unused:
--unused:	ExtensionContainer
--unused:FROM MAP-ExtensionDataTypes {
--unused:	itu-t identified-organization (4) etsi (0) mobileDomain (0)
--unused:	gsm-Network (1) modules (3) map-ExtensionDataTypes (21) version13 (13)}
--unused:	;

--unused:RoamingNotAllowedParam  ::= SEQUENCE {
--unused:	roamingNotAllowedCause  RoamingNotAllowedCause,
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	additionalRoamingNotAllowedCause  [0] AdditionalRoamingNotAllowedCause OPTIONAL }
--unused:
--unused:- -  if the additionalRoamingNotallowedCause is received by the MSC/VLR or SGSN then the
--unused:- -  roamingNotAllowedCause shall be discarded.
--unused:
--unused:AdditionalRoamingNotAllowedCause  ::= ENUMERATED {
--unused:	supportedRAT-TypesNotAllowed (0),
--unused:	...}
--unused:
--unused:RoamingNotAllowedCause  ::= ENUMERATED {
--unused:	plmnRoamingNotAllowed  (0),
--unused:	operatorDeterminedBarring  (3)}
--unused:
--unused:CallBarredParam ::= CHOICE {
--unused:	callBarringCause  CallBarringCause,
--unused:	- - call BarringCause must not be used in version 3 and higher
--unused:	extensibleCallBarredParam  ExtensibleCallBarredParam
--unused:	- - extensibleCallBarredParam must not be used in version <3
--unused:	}
--unused:
--unused:CallBarringCause ::= ENUMERATED {
--unused:	barringServiceActive  (0),
--unused:	operatorBarring  (1)}
--unused:
--unused:ExtensibleCallBarredParam ::= SEQUENCE {
--unused:	callBarringCause  CallBarringCause  OPTIONAL,
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	... ,
--unused:	unauthorisedMessageOriginator  [1] NULL    OPTIONAL }
--unused:
--unused:CUG-RejectParam ::= SEQUENCE {
--unused:	cug-RejectCause  CUG-RejectCause  OPTIONAL,
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:CUG-RejectCause ::= ENUMERATED {
--unused:	incomingCallsBarredWithinCUG  (0),
--unused:	subscriberNotMemberOfCUG  (1),
--unused:	requestedBasicServiceViolatesCUG-Constraints  (5),
--unused:	calledPartySS-InteractionViolation  (7)}
--unused:
--unused:SS-IncompatibilityCause ::= SEQUENCE {
--unused:	ss-Code   [1] SS-Code  OPTIONAL,
--unused:	basicService  BasicServiceCode  OPTIONAL,
--unused:	ss-Status  [4] SS-Status OPTIONAL,
--unused:	...}
--unused:
--unused:PW-RegistrationFailureCause  ::= ENUMERATED {
--unused:	undetermined  (0),
--unused:	invalidFormat  (1),
--unused:	newPasswordsMismatch  (2)}
--unused:
--unused:SM-EnumeratedDeliveryFailureCause ::= ENUMERATED {
--unused:	memoryCapacityExceeded  (0),
--unused:	equipmentProtocolError  (1),
--unused:	equipmentNotSM-Equipped  (2),
--unused:	unknownServiceCentre  (3),
--unused:	sc-Congestion  (4),
--unused:	invalidSME-Address  (5),
--unused:	subscriberNotSC-Subscriber  (6)}
--unused:
--unused:SM-DeliveryFailureCause ::= SEQUENCE {
--unused:	sm-EnumeratedDeliveryFailureCause SM-EnumeratedDeliveryFailureCause,
--unused:	diagnosticInfo  SignalInfo  OPTIONAL,
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:AbsentSubscriberSM-Param ::= SEQUENCE {
--unused:	absentSubscriberDiagnosticSM  AbsentSubscriberDiagnosticSM  OPTIONAL,
--unused:	- - AbsentSubscriberDiagnosticSM can be either for non-GPRS
--unused:	- - or for GPRS
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	additionalAbsentSubscriberDiagnosticSM    [0]  AbsentSubscriberDiagnosticSM OPTIONAL }
--unused:	- - if received, additionalAbsentSubscriberDiagnosticSM
--unused:	- - is for GPRS and absentSubscriberDiagnosticSM is
--unused:	- - for non-GPRS

AbsentSubscriberDiagnosticSM ::= INTEGER (0..255)
	-- AbsentSubscriberDiagnosticSM values are defined in 3GPP TS 23.040

--unused:SystemFailureParam ::= CHOICE {
--unused:	networkResource  NetworkResource,
--unused:	 - - networkResource must not be used in version 3
--unused:	extensibleSystemFailureParam  ExtensibleSystemFailureParam
--unused:	 - - extensibleSystemFailureParam must not be used in version <3
--unused:	}
--unused:
--unused:ExtensibleSystemFailureParam ::= SEQUENCE {
--unused:	networkResource  NetworkResource  OPTIONAL,
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	additionalNetworkResource  [0] AdditionalNetworkResource  OPTIONAL,
--unused:	failureCauseParam  [1] FailureCauseParam  OPTIONAL }
--unused:
--unused:FailureCauseParam  ::= ENUMERATED {
--unused:	limitReachedOnNumberOfConcurrentLocationRequests (0),
--unused:	... }
--unused:	 - - if unknown value is received in  FailureCauseParam it shall be ignored
--unused:
--unused:
--unused:DataMissingParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:UnexpectedDataParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
