--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	shapeOfLocationEstimateNotSupported [0] NULL   OPTIONAL,
--unused:	neededLcsCapabilityNotSupportedInServingNode [1] NULL  OPTIONAL }
--unused:
--unused:OR-NotAllowedParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:UnknownSubscriberParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	unknownSubscriberDiagnostic  UnknownSubscriberDiagnostic  OPTIONAL}
--unused:
--unused:UnknownSubscriberDiagnostic  ::= ENUMERATED {
--unused:	imsiUnknown  (0),
--unused:	gprs-eps-SubscriptionUnknown  (1),
--unused:	...,
--unused:	npdbMismatch  (2)}
--unused:	- - if unknown values are received in
--unused:	- - UnknownSubscriberDiagnostic they shall be discarded
--unused:
--unused:NumberChangedParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:UnidentifiedSubParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:IllegalSubscriberParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:IllegalEquipmentParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:BearerServNotProvParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:TeleservNotProvParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:TracingBufferFullParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:NoRoamingNbParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
--unused:AbsentSubscriberParam ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	absentSubscriberReason  [0] AbsentSubscriberReason  OPTIONAL}
--unused:
--unused:AbsentSubscriberReason  ::= ENUMERATED {
--unused:	imsiDetach (0),
--unused:	restrictedArea (1),
--unused:	noPageResponse (2),
--unused:	... ,
--unused:	purgedMS (3),
--unused:	mtRoamingRetry (4),
--unused:	busySubscriber (5)}
--unused:- - exception handling: at reception of other values than the ones listed the
--unused:- - AbsentSubscriberReason shall be ignored.
--unused:- - The AbsentSubscriberReason: purgedMS is defined for the Super-Charger feature
--unused:- - (see TS 23.116). If this value is received in a Provide Roaming Number response
--unused:- - it shall be mapped to the AbsentSubscriberReason: imsiDetach in the Send Routeing
--unused:- - Information response
--unused:- - The AbsentSubscriberReason: mtRoamingRetry is used during MT Roaming Retry,
--unused:- - see 3GPP TS 23.018[97].
--unused:- - The AbsentSubscriberReason: busySubscriber is used during MT Roaming Forwarding,
--unused:- - see 3GPP TS 23.018[97].
--unused:
--unused:BusySubscriberParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...,
--unused:	ccbs-Possible  [0] NULL   OPTIONAL,
--unused:	ccbs-Busy  [1] NULL  OPTIONAL}
--unused:
--unused:NoSubscriberReplyParam  ::= SEQUENCE {
--unused:	extensionContainer  ExtensionContainer  OPTIONAL,
--unused:	...}
--unused:
