-- Must import data types for the "old" asn1 defs collected here.
IMPORTS
	AddressString,
	--unused:BasicServiceCode,
	--unused:ExternalSignalInfo,
	GlobalCellId,
	ISDN-AddressString,
	IMSI,
	--unused:IMSI-WithLMSI,
	LMSI,
	ProtocolId,
	SignalInfo, 
        SubscriberIdentity
FROM MAP-CommonDataTypes {
   itu-t identified-organization (4) etsi (0) mobileDomain (0)
   gsm-Network (1) modules (3) map-CommonDataTypes (18) --version11 (11)-- version13 (13)}

	ExtensionContainer
FROM MAP-ExtensionDataTypes {
   itu-t identified-organization (4) etsi (0) mobileDomain (0)
   gsm-Network (1) modules (3) map-ExtensionDataTypes (21) --version11 (11)-- version13 (13)}

   --unused:CUG-CheckInfo,
   --unused:NumberOfForwarding,
   RoutingInfo
FROM MAP-CH-DataTypes {
   itu-t identified-organization (4) etsi (0) mobileDomain (0)
   gsm-Network (1) modules (3) map-CH-DataTypes (13) --version11 (11)-- version13 (13)}

  RAND,
  SRES,
  Kc --unused:,
  --unused:AuthenticationTripletV1, - -unused:   TripletList,
--unused:  SubscriberData - -unused:   Category
FROM MAP-MS-DataTypes {
   itu-t identified-organization (4) etsi (0) mobileDomain (0)
   gsm-Network (1) modules (3) map-MS-DataTypes (11) version13 (13)}
;

