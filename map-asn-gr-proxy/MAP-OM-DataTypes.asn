ActivateTraceModeArg ::= SEQUENCE { 
	imsi    [0] IMSI   OPTIONAL, 
	traceReference  [1] TraceReference, 
	traceType  [2] TraceType,   
	--unused:omc-Id   [3] AddressString  OPTIONAL, 
	--unused:extensionContainer  [4] ExtensionContainer  OPTIONAL, 
	...--unused:, 
	--unused:traceReference2  [5] TraceReference2  OPTIONAL, 
	--unused:traceDepthList  [6] TraceDepthList  OPTIONAL, 
	--unused:traceNE-TypeList  [7] TraceNE-TypeList  OPTIONAL, 
	--unused:traceInterfaceList  [8] TraceInterfaceList  OPTIONAL, 
	--unused:traceEventList  [9] TraceEventList  OPTIONAL, 
	--unused:traceCollectionEntity  [10] GSN-Address  OPTIONAL, 
	--unused:mdt-Configuration  [11] MDT-Configuration  OPTIONAL 
	} 
 
