-- ETSI TS 129 002 V10.4.0 (2011-10)
-- 17.7.2  Operation and maintenance data types 

MAP-OM-DataTypes { 
   itu-t identified-organization (4) etsi (0) mobileDomain (0) 
   gsm-Network (1) modules (3) map-OM-DataTypes (12) version13 (13)} 
 
DEFINITIONS 
 
IMPLICIT TAGS 
 
::= 
 
BEGIN 
 
--unused:EXPORTS 
--unused:	ActivateTraceModeArg, 
--unused:	ActivateTraceModeRes, 
--unused:	DeactivateTraceModeArg, 
--unused:	DeactivateTraceModeRes, 
--unused:	TracePropagationList 
--unused:	; 
 
IMPORTS 
	--unused:AddressString, 
