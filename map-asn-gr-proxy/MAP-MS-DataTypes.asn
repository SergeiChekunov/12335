--unused:	sipto-Permission [14] SIPTO-Permission OPTIONAL,
--unused:	lipa-Permission [15] LIPA-Permission OPTIONAL
--unused:	}

--unused:PDN-Type ::= OCTET STRING (SIZE (1))
	-- Octet is coded according to TS 3GPP TS 29.274 [140]

