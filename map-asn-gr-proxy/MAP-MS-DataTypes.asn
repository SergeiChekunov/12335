--unused:    rfsp-id [2] RFSP-ID OPTIONAL,
--unused:    ambr [3] AMBR OPTIONAL,
--unused:    apn-ConfigurationProfile [4] APN-ConfigurationProfile OPTIONAL,
--unused:    stn-sr [6] ISDN-AddressString OPTIONAL,
--unused:    extensionContainer [5] ExtensionContainer OPTIONAL,
--unused:    ...,
--unused:    mps-CSPriority [7] NULL OPTIONAL,
--unused:    mps-EPSPriority [8] NULL OPTIONAL }
   -- mps-CSPriority by its presence indicates that the UE is subscribed to the eMLPP in
