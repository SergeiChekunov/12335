UESBI-Iu ::= SEQUENCE {
	uesbi-IuA [0] UESBI-IuA OPTIONAL,
	uesbi-IuB [1] UESBI-IuB OPTIONAL,
	...}

UESBI-IuA ::= BIT STRING (SIZE(1..128))
	-- See 3GPP TS 25.413

UESBI-IuB ::= BIT STRING (SIZE(1..128))
	-- See 3GPP TS 25.413

--unused:EquipmentStatus ::= ENUMERATED {
--unused:	whiteListed (0),
--unused:	blackListed (1),
--unused:	greyListed (2)}

-- subscriber management types

InsertSubscriberDataArg ::= SEQUENCE {
    imsi [0] IMSI OPTIONAL,
-- COMPONENTS OF SubscriberData,
	msisdn [1] ISDN-AddressString OPTIONAL,
	category [2] Category OPTIONAL,
	subscriberStatus [3] SubscriberStatus OPTIONAL,
	bearerServiceList [4] BearerServiceList OPTIONAL,
	-- The exception handling for reception of unsupported / not allocated
	-- bearerServiceCodes is defined in section 8.8.1
	teleserviceList [6] TeleserviceList OPTIONAL,
	-- The exception handling for reception of unsupported / not allocated
	-- teleserviceCodes is defined in section 8.8.1
	provisionedSS [7] Ext-SS-InfoList OPTIONAL,
	odb-Data [8] ODB-Data OPTIONAL,
	roamingRestrictionDueToUnsupportedFeature [9] NULL OPTIONAL,
	regionalSubscriptionData [10] ZoneCodeList OPTIONAL,
	vbsSubscriptionData [11] VBSDataList OPTIONAL,
	vgcsSubscriptionData [12] VGCSDataList OPTIONAL,
	vlrCamelSubscriptionInfo [13] VlrCamelSubscriptionInfo OPTIONAL,
-- End OF COMPONENTS OF SubscriberData
    --unused:extensionContainer [14] ExtensionContainer OPTIONAL,
    ... --unused:,
    --unused:naea-PreferredCI [15] NAEA-PreferredCI OPTIONAL,
    --unused:- - naea-PreferredCI is included at the discretion of the HLR operator.
    --unused:gprsSubscriptionData [16] GPRSSubscriptionData OPTIONAL,
    --unused:roamingRestrictedInSgsnDueToUnsupportedFeature [23] NULL OPTIONAL,
    --unused:networkAccessMode [24] NetworkAccessMode OPTIONAL,
    --unused:lsaInformation [25] LSAInformation OPTIONAL,
    --unused:lmu-Indicator [21] NULL OPTIONAL,
    --unused:lcsInformation [22] LCSInformation OPTIONAL,
    --unused:istAlertTimer [26] IST-AlertTimerValue OPTIONAL,
    --unused:superChargerSupportedInHLR [27] AgeIndicator OPTIONAL,
    --unused:mc-SS-Info [28] MC-SS-Info OPTIONAL,
    --unused:cs-AllocationRetentionPriority [29] CS-AllocationRetentionPriority OPTIONAL,
    --unused:sgsn-CAMEL-SubscriptionInfo [17] SGSN-CAMEL-SubscriptionInfo OPTIONAL,
    --unused:chargingCharacteristics [18] ChargingCharacteristics OPTIONAL,
    --unused:accessRestrictionData [19] AccessRestrictionData OPTIONAL,
    --unused:ics-Indicator [20] BOOLEAN OPTIONAL,
    --unused:eps-SubscriptionData [31] EPS-SubscriptionData OPTIONAL,
    --unused:csg-SubscriptionDataList [32] CSG-SubscriptionDataList OPTIONAL,
    --unused:ue-ReachabilityRequestIndicator [33] NULL OPTIONAL,
    --unused:sgsn-Number [34] ISDN-AddressString OPTIONAL,
    --unused:mme-Name [35] DiameterIdentity OPTIONAL,
