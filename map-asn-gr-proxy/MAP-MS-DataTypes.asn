--unused:    ServingNode ::= BIT STRING {
--unused:    mme (0),
--unused:    sgsn (1)} (SIZE (2..8))
    -- Other bits than listed above shall be discarded.

AnyTimeModificationRes ::= SEQUENCE {
    ss-InfoFor-CSE [0] Ext-SS-InfoFor-CSE OPTIONAL,
    --unused:camel-SubscriptionInfo [1] CAMEL-SubscriptionInfo OPTIONAL,
    --unused:extensionContainer [2] ExtensionContainer OPTIONAL,
    ...--unused:,
    --unused:odb-Info [3] ODB-Info OPTIONAL,
    --unused:cw-Data [4] CallWaitingData OPTIONAL,
    --unused:ch-Data [5] CallHoldData OPTIONAL,
    --unused:clip-Data [6] ClipData OPTIONAL,
    --unused:clir-Data [7] ClirData OPTIONAL,
    --unused:ect-data [8] EctData OPTIONAL,
    --unused:serviceCentreAddress [9] AddressString OPTIONAL
    }

ModificationRequestFor-CF-Info ::= SEQUENCE {
    ss-Code [0] SS-Code,
    basicService [1] Ext-BasicServiceCode OPTIONAL,
    ss-Status [2] Ext-SS-Status OPTIONAL,
    forwardedToNumber [3] AddressString OPTIONAL,
    forwardedToSubaddress [4] ISDN-SubaddressString OPTIONAL,
    noReplyConditionTime [5] Ext-NoRepCondTime OPTIONAL,
    modifyNotificationToCSE [6] ModificationInstruction OPTIONAL,
    extensionContainer [7] ExtensionContainer OPTIONAL,
    ...}

--unused:ModificationRequestFor-CB-Info ::= SEQUENCE {
--unused:    ss-Code [0] SS-Code,
--unused:    basicService [1] Ext-BasicServiceCode OPTIONAL,
--unused:    ss-Status [2] Ext-SS-Status OPTIONAL,
--unused:    password [3] Password OPTIONAL,
--unused:    wrongPasswordAttemptsCounter [4] WrongPasswordAttemptsCounter OPTIONAL,
--unused:    modifyNotificationToCSE [5] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [6] ExtensionContainer OPTIONAL,
--unused:    ...}

--unused:ModificationRequestFor-ODB-data ::= SEQUENCE {
--unused:    odb-data [0] ODB-Data OPTIONAL,
--unused:    modifyNotificationToCSE [1] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [2] ExtensionContainer OPTIONAL,
--unused:    ...}

--unused:ModificationRequestFor-CSI ::= SEQUENCE {
--unused:    requestedCamel-SubscriptionInfo [0] RequestedCAMEL-SubscriptionInfo,
--unused:    modifyNotificationToCSE [1] ModificationInstruction OPTIONAL,
--unused:    modifyCSI-State [2] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [3] ExtensionContainer OPTIONAL,
--unused:    ...,
--unused:    additionalRequestedCAMEL-SubscriptionInfo
--unused:    [4] AdditionalRequestedCAMEL-SubscriptionInfo
--unused:    OPTIONAL }
    -- requestedCamel-SubscriptionInfo shall be discarded if
    -- additionalRequestedCAMEL-SubscriptionInfo is received

--unused:ModificationRequestFor-IP-SM-GW-Data ::= SEQUENCE {
--unused:    modifyRegistrationStatus [0] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [1] ExtensionContainer OPTIONAL,
--unused:    ...}

ModificationInstruction ::= ENUMERATED {
    deactivate (0),
    activate (1)}

-- subscriber data modification notification types
NoteSubscriberDataModifiedArg ::= SEQUENCE {
    imsi IMSI,
    msisdn ISDN-AddressString,
    forwardingInfoFor-CSE [0] Ext-ForwardingInfoFor-CSE OPTIONAL,
    --unused:callBarringInfoFor-CSE [1] Ext-CallBarringInfoFor-CSE OPTIONAL,
    --unused:odb-Info [2] ODB-Info OPTIONAL,
    --unused:camel-SubscriptionInfo [3] CAMEL-SubscriptionInfo OPTIONAL,
    --unused:allInformationSent [4] NULL OPTIONAL,
    --unused:extensionContainer ExtensionContainer OPTIONAL,
    ...--unused:,
    --unused:ue-reachable [5] ServingNode OPTIONAL,
    --unused:csg-SubscriptionDataList [6] CSG-SubscriptionDataList OPTIONAL,
    --unused:cw-Data [7] CallWaitingData OPTIONAL,
    --unused:ch-Data [8] CallHoldData OPTIONAL,
    --unused:clip-Data [9] ClipData OPTIONAL,
    --unused:clir-Data [10] ClirData OPTIONAL,
    --unused:ect-data [11] EctData OPTIONAL-- }

--unused:NoteSubscriberDataModifiedRes ::= SEQUENCE {
--unused:    extensionContainer ExtensionContainer OPTIONAL,
--unused:    ...}

-- mobility management event notificatioon info types
NoteMM-EventArg::= SEQUENCE {
    serviceKey ServiceKey,
    eventMet [0] MM-Code,
    imsi [1] IMSI,
    msisdn [2] ISDN-AddressString,
    locationInformation [3] LocationInformation OPTIONAL,
    supportedCAMELPhases [5] SupportedCamelPhases OPTIONAL,
    extensionContainer [6] ExtensionContainer OPTIONAL,
    ...,
    locationInformationGPRS [7] LocationInformationGPRS OPTIONAL --unused:,
    --unused:offeredCamel4Functionalities [8] OfferedCamel4Functionalities OPTIONAL
    }

--unused:NoteMM-EventRes ::= SEQUENCE {
--unused:    extensionContainer ExtensionContainer OPTIONAL,
--unused:    ...}

Ext-SS-InfoFor-CSE ::= CHOICE {
    forwardingInfoFor-CSE [0] Ext-ForwardingInfoFor-CSE,
    callBarringInfoFor-CSE [1] Ext-CallBarringInfoFor-CSE
    }

Ext-ForwardingInfoFor-CSE ::= SEQUENCE {
    ss-Code [0] SS-Code,
    forwardingFeatureList [1] Ext-ForwFeatureList,
    --unused:notificationToCSE [2] NULL OPTIONAL,
    --unused:extensionContainer [3] ExtensionContainer OPTIONAL,
    ...}

Ext-CallBarringInfoFor-CSE ::= SEQUENCE {
    ss-Code [0] SS-Code,
    callBarringFeatureList [1] Ext-CallBarFeatureList,
    password [2] Password OPTIONAL,
    wrongPasswordAttemptsCounter [3] WrongPasswordAttemptsCounter OPTIONAL,
    notificationToCSE [4] NULL OPTIONAL,
    extensionContainer [5] ExtensionContainer OPTIONAL,
    ...}

END
