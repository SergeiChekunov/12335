--unused:    modifyNotificationToCSE [1] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [2] ExtensionContainer OPTIONAL,
--unused:    ...}

--unused:ModificationRequestFor-CLIR-Info ::= SEQUENCE {
--unused:    ss-Status [0] Ext-SS-Status OPTIONAL,
--unused:    cliRestrictionOption [1] CliRestrictionOption OPTIONAL,
--unused:    modifyNotificationToCSE [2] ModificationInstruction OPTIONAL,
--unused:    extensionContainer [3] ExtensionContainer OPTIONAL,
--unused:    ...}

--unused:ModificationRequestFor-CLIP-Info ::= SEQUENCE {
