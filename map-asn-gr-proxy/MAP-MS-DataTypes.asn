    --unused:subscribedPeriodicLAUtimer [39] SubscribedPeriodicLAUtimer OPTIONAL,
    --unused:additionalMSISDN [41] ISDN-AddressString OPTIONAL-- }
    -- If the Network Access Mode parameter is sent, it shall be present only in
    -- the first sequence if seqmentation is used

