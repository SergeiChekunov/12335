--        unexpectedDataValue |
--        callBarred |
--        illegalSS-Operation |
--        ss-ErrorStatus |
--        ss-Incompatibility |
--        shortTermDenial |
--        longTermDenial |
--        facilityNotSupported}
--    CODE    local:76 }

--eraseCC-Entry  OPERATION ::= { - -Timer m
--    ARGUMENT
--        EraseCC-EntryArg
--    RESULT
--        EraseCC-EntryRes
--    ERRORS {
--        systemFailure |
--        dataMissing |
--        unexpectedDataValue |
--        callBarred |
--        illegalSS-Operation |
--        ss-ErrorStatus}
--    CODE    local:77 }

END
